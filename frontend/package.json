{
  "name": "bifrost-monitor-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "npm run sync:massive-coverage && next build",
    "start": "next start -p 5173",
    "lint": "next lint && npm run lint:legacy-classes",
    "lint:legacy-classes": "node scripts/check-legacy-classnames.mjs",
    "css:metrics": "node scripts/css-legacy-metrics.mjs",
    "css:metrics:verbose": "node scripts/css-legacy-metrics.mjs --verbose",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "css:retirement:status": "node scripts/css-legacy-metrics.mjs && node -e \"const n=require('./scripts/legacy-class-allowlist.json').files.length;console.log('allowlist files:',n)\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sync:massive-coverage": "mkdir -p public/plans && cp ../docs/plans/massive_api_coverage.html public/plans/massive_api_coverage.html && cp ../docs/plans/massive_api_coverage.csv public/plans/massive_api_coverage.csv && cp ../docs/plans/ib_stock_api_coverage.html public/plans/ib_stock_api_coverage.html && cp ../docs/plans/ib_stock_coverage.csv public/plans/ib_stock_coverage.csv && cp ../docs/plans/massive_stocks_api_coverage.html public/plans/massive_stocks_api_coverage.html && cp ../docs/plans/massive_stocks_api_coverage.csv public/plans/massive_stocks_api_coverage.csv"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
