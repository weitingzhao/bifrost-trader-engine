# Copy to config.dev.yaml and fill in real values. Do not commit secrets.

postgres:
  host: "127.0.0.1"
  port: 5432
  database: "bifrost"
  user: "bifrost"
  password: "" # or PGPASSWORD env

ib:
  connect_timeout: 60.0
  host:
    ip: "127.0.0.1"
    port_type: "tws_live"
    client_id:
      daemon: 110
      listener: 101
      account: 120
      markets: 130
      worker_market: 140
  secondary:
    ip: "127.0.0.1"
    port_type: "tws_live"
    client_id:
      listener: 11
      account: 120

redis:
  enabled: true
  host: "127.0.0.1"
  port: 6379

server:
  port: 8765 # Monitor API (run_server.py); omit only if you rely on script default
  massive_port: 8766
  docs_port: 8767
  ops_port: 8768
  trading_port: 8769   # trading API server
  strategy_port: 8770  # strategy API server
  portfolio_port: 8771 # portfolio API server
  market_port: 8772    # market API server

frontend:
  port: 5173
  # Optional: Settings → API Health + browser API routing (GET /health).
  # When config_profile is dev and dev_path is set, the UI builds trading/strategy/portfolio/market
  # origins as this host + server.trading_port / strategy_port / portfolio_port / market_port from YAML
  # even if utilized.services omits those rows. Massive/Docs still follow utilized.services.
  # dev_path: "http://192.168.x.x"     # host — ports come from server.*_port in this file
  # prod_path: "https://your-prod-host"

# Optional: per FastAPI microservice — dev or prod for browser API routing (GET /health utilized_services).
# Prefer a mapping (one key per service). Legacy list form (e.g. - massive:"dev") still works.
# utilized:
#   services:
#     server: dev
#     massive: dev
#     docs: dev
#     ops: dev
#     trading: dev
#     strategy: dev
#     portfolio: dev
#     market: dev
#     research: dev

# Massive / Polygon options research (REST + Celery queue `massive`). Do not commit real API keys.
# Prefer env: MASSIVE_API_KEY or POLYGON_API_KEY
massive:
  api_key: "" # placeholder
  tier: "starter" # starter | developer
  rest_base: "https://api.polygon.io"
  ws_url: "wss://socket.polygon.io/options"
  features:
    trades_enabled: false # Developer tier can set true
  expiration_cache:
    enabled: true
    ttl_trading_sec: 3600
    ttl_off_hours_sec: 43200
    stale_while_revalidate: true
    beat_batch_size: 12

# Ops control plane (run_server_ops.py): Celery systemd + optional market ingest services.
# Whitelist stems for RestrictedExecutor (matches bifrost-celery-worker@*.service, redis, etc.).
# ops:
#   allowed_units:
#     - bifrost-celery-worker
#     - bifrost-celery-beat
#     - bifrost-massive-ws
#   # Registered in GET /ops/market-ingest/services (UI: Settings → Market ingest).
#   market_ingest_services:
#     - id: massive_ws
#       label: "Massive Options WS ingest"
#       systemd_unit: bifrost-massive-ws.service
#       redis_meta_key: massive:meta:status
#   # Future (separate process; enable when implemented):
#   # - id: ib_market
#   #   label: "IB market ingest"
#   #   systemd_unit: bifrost-ib-market-ingest.service
#   #   redis_meta_key: ib:meta:status
