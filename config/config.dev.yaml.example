# Copy to config.dev.yaml and fill in real values. Do not commit secrets.

postgres:
  host: "127.0.0.1"
  port: 5432
  database: "bifrost"
  user: "bifrost"
  password: "" # or PGPASSWORD env

# IB Operator cmd RPC (scripts/run_ib_operator.py). Legacy key ib_gateway is still read with a deprecation warning.
# ib_operator:
#   enabled: true

ib:
  connect_timeout: 60.0
  host:
    ip: "127.0.0.1"
    # Primary API port (7496 live / 7497 paper / 4002 gateway). IB Operator uses this port + client_id.operator.
    port_type: "tws_live"
    # IB ingestor (run_ib_ingestor.py) may use a different port; omit = same as port_type.
    # port_type_market_data: "tws_paper"
    client_id:
      daemon: 110
      listener: 101
      operator: 120
      worker_market: 140
      # IB ingestor (scripts/run_ib_ingestor.py); must not overlap operator/daemon/Celery IDs.
      ingestor: 150
  secondary:
    ip: "127.0.0.1"
    port_type: "tws_live"
    client_id:
      listener: 11
      operator: 120

redis:
  enabled: true
  host: "127.0.0.1"
  port: 6379
  # Optional: SSE subscribes to redis.subscribe_channel (default ib:ingester:channel).
  # subscribe_channel: ib:ingester:channel

# Categories: Architecture, Account, Research, Feed (same as Settings → Services Overview).
server:
  architecture:
    monitor_port: 8765 # Monitor API (run_server.py)
    docs_port: 8767
    ops_port: 8768
  account:
    trading_port: 8769
    portfolio_port: 8771
  research:
    research_port: 8773
    market_port: 8772
    strategy_port: 8770
  feed:
    massive_port: 8766

frontend:
  port: 5173
  # Optional: Settings → API Health + browser API routing (GET /health).
  # When config_profile is dev and dev_path is set, the UI builds trading/strategy/portfolio/market
  # origins as this host + flattened server.*_port from YAML (after read_config normalization)
  # even if utilized.services omits those rows. Massive/Docs still follow utilized.services.
  # dev_path: "http://192.168.x.x"     # host — ports come from server.account/research/feed/architecture in this file
  # prod_path: "https://your-prod-host"

# Optional: per FastAPI microservice — dev or prod for browser API routing (GET /health utilized_services).
# Prefer a mapping (one key per service). Legacy list form (e.g. - massive:"dev") still works.
# utilized:
#   services:
#     server: dev
#     massive: dev
#     docs: dev
#     ops: dev
#     trading: dev
#     strategy: dev
#     portfolio: dev
#     market: dev
#     research: dev

# Massive / Polygon options research (REST + Celery queue `massive`). Do not commit real API keys.
# Prefer env: MASSIVE_API_KEY or POLYGON_API_KEY
massive:
  api_key: "" # placeholder
  tier: "starter" # starter | developer
  rest_base: "https://api.polygon.io"
  ws_url: "wss://socket.polygon.io/options"
  features:
    trades_enabled: false # Developer tier can set true
  expiration_cache:
    enabled: true
    ttl_trading_sec: 3600
    ttl_off_hours_sec: 43200
    stale_while_revalidate: true
    beat_batch_size: 12

# Ops control plane (run_server_ops.py): Celery systemd + optional market ingest services.
# Whitelist stems for RestrictedExecutor (matches bifrost-celery-worker@*.service, redis, etc.).
# On macOS, local_control: subprocess runs Celery via run_celery.py and WS Connector ingest via
# scripts/run_massive_ws.py, run_ib_operator.py, run_ib_ingestor.py (GET /ops/health market_ingest_script_control).
# ops:
#   local_control: subprocess
#   allowed_units:
#     - bifrost-celery-worker
#     - bifrost-celery-beat
#     - bifrost-massive-ws
#     - bifrost-ib-operator
#     - bifrost-ib-ingestor
#     - bifrost-ib-account-agent
#   market_ingest_services:
#     - id: massive_ws
#       label: "Massive Options WS ingest"
#       systemd_unit: bifrost-massive-ws.service
#       redis_meta_key: bifrost:health:ws_massive_option
#     - id: ib_operator
#       label: "IB Operator (cmd RPC)"
#       systemd_unit: bifrost-ib-operator.service
#       redis_meta_key: bifrost:health:ws_ib_operator
#     - id: ib_ingestor
#       label: "IB ingestor"
#       systemd_unit: bifrost-ib-ingestor.service
#       redis_meta_key: bifrost:health:ws_ib_ingestor

# IB ingestor (scripts/run_ib_ingestor.py): Watchlist-driven; caps subscription count. Legacy top-level key ib_market_ingest still read.
# ib_ingestor:
