# HTTPS server block — copy or symlink AFTER Let's Encrypt (or other) certs exist.
#
#   sudo cp deploy/nginx/bifrost-status-ssl.conf.example /etc/nginx/sites-available/bifrost-status-ssl
#   # Edit ssl_certificate paths if your domain is not ai.trader
#   sudo ln -sf /etc/nginx/sites-available/bifrost-status-ssl /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# If nginx -t fails with "cannot load certificate", either fix PEM paths or remove this site from sites-enabled.

# --- HTTPS (same routes as bifrost-status.conf HTTP block) ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ai.trader 192.168.10.70 127.0.0.1 localhost;

    ssl_certificate     /etc/letsencrypt/live/ai.trader/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.trader/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /research/massive {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location ^~ /research/docs {
        proxy_pass http://127.0.0.1:8767;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location ^~ /bifrost-api-docs/ {
        proxy_pass http://127.0.0.1:8767/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ops {
        # allow 192.168.10.0/24;
        # deny all;

        proxy_pass http://127.0.0.1:8768;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }
}
