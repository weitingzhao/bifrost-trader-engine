# Reverse proxy for Bifrost APIs + Next.js frontend. Ports are filled from merged YAML (do not edit by hand); regenerate with:
#   python scripts/systemd/render_nginx_status_conf.py
# Uses merged YAML (config.yaml + config.prod.yaml when BIFROST_CONFIG points at prod), same as uvicorn.
#
# Path → backend (single origin :80; matches FastAPI route prefixes in backend/*/routers):
#   /research/massive → Massive | /research/docs, /bifrost-api-docs/ → Docs | /ops → Ops
#   /strategies/ → Strategy | /portfolio/ → Portfolio | /position-categories → Monitor (same DB; optional Portfolio process)
#   /trading/, /executions, /performance, /transactions → Trading
#   /bars, /watchlist, /quotes, /market/, /indices/ → Market
#   /research/<api-prefix> → Research API (granular; matches frontend next.config dev rewrites)
#   /research/{risk,sepa,…} → Next.js UI pages (must not use catch-all /research/ → API)
#   /status, /health, /operations, /control, /positions, /account-sync, /risk_summary, /config, /api, /openapi.json → Monitor
#   /mkdocs/ → static MkDocs (site/ from mkdocs build; publish: ./scripts/bifrost_ssh.sh --deploy-mkdocs)
#   /_next/static/ → Next.js hashed assets (served directly by nginx)
#   / → Next.js frontend (bifrost-frontend.service). GET /health is Monitor, not frontend.
#
# Install (Debian/Ubuntu) — HTTP only; nginx -t passes without TLS files:
#   python scripts/systemd/render_nginx_status_conf.py
#   sudo cp deploy/nginx/bifrost-status.conf /etc/nginx/sites-available/bifrost-status
#   sudo ln -sf /etc/nginx/sites-available/bifrost-status /etc/nginx/sites-enabled/bifrost-status
#   sudo nginx -t && sudo systemctl reload nginx
#
# HTTPS (optional): render ssl template then copy (see bifrost-status-ssl.conf.template).
#
# Hostname: add your DNS (e.g. ai.trader) to server_name; if https://... 404s, check nginx -T | grep server_name
#
# Uvicorn backends speak HTTP only. Do NOT use https://host:<port> in proxy_pass — terminate TLS in nginx.

# UI vs API on overlapping paths (included in http {} before server block).
map $request_method $bifrost_research_screener_port {
    POST    @@BIFROST_RESEARCH_PORT@@;
    default @@BIFROST_FRONTEND_PORT@@;
}
map $http_rsc $bifrost_research_greeks_port_rsc {
    "~." @@BIFROST_FRONTEND_PORT@@;
    default "";
}
map $http_accept $bifrost_research_greeks_port_accept {
    "~*text/html" @@BIFROST_FRONTEND_PORT@@;
    default @@BIFROST_RESEARCH_PORT@@;
}
map $bifrost_research_greeks_port_rsc $bifrost_research_greeks_port {
    ""      $bifrost_research_greeks_port_accept;
    default $bifrost_research_greeks_port_rsc;
}
map $http_rsc $bifrost_portfolio_model_port_rsc {
    "~." @@BIFROST_FRONTEND_PORT@@;
    default "";
}
map $http_accept $bifrost_portfolio_model_port_accept {
    "~*text/html" @@BIFROST_FRONTEND_PORT@@;
    default @@BIFROST_PORTFOLIO_PORT@@;
}
map $bifrost_portfolio_model_port_rsc $bifrost_portfolio_model_port {
    ""      $bifrost_portfolio_model_port_accept;
    default $bifrost_portfolio_model_port_rsc;
}

