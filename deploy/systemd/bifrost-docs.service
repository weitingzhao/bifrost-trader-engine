[Unit]
Description=Bifrost merged OpenAPI docs server (run_server_docs.py)
After=network-online.target bifrost-server.service bifrost-massive.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_ENV=prod
# When nginx proxies http://<host>/bifrost-api-docs/ -> 127.0.0.1:8767/ (see deploy/nginx/bifrost-status.conf):
# Environment=BIFROST_DOCS_ROOT_PATH=/bifrost-api-docs
# Omit when using only http://<host>:8767/docs (direct port).
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/run_server_docs.py --prod
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
