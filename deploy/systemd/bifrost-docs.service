[Unit]
Description=Bifrost Docs API server (merged OpenAPI, run_server_docs.py)
After=network-online.target bifrost-server.service bifrost-massive.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_ENV=prod
# Canonical URL behind nginx: https://<host>/research/docs/docs (see deploy/nginx/bifrost-status.conf).
# Legacy path http://<host>/bifrost-api-docs/ -> 127.0.0.1:8767/ (stripped); set for correct Swagger openapi URL:
# Environment=BIFROST_DOCS_ROOT_PATH=/bifrost-api-docs
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/run_server_docs.py --prod
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
