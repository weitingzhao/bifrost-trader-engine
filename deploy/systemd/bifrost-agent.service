[Unit]
Description=Bifrost Local Control Agent (privileged systemd executor)
After=network.target
Documentation=https://github.com/your-org/bifrost-trader-engine
# After git pull: allowed units live in backend/ops/agent/protocol.py — restart this service so
# new units are accepted (e.g. bifrost-engine.service, bifrost-ib-account-agent.service).

[Service]
Type=simple
User=bifrost-agent
Group=bifrost-agent
# Same tree as bifrost-server.service; requires chmod o+x /home/vision so bifrost-agent can traverse.
WorkingDirectory=/home/vision/bifrost-trader-engine
# Socket under RuntimeDirectory — bind() in /run/ root fails with ProtectSystem=strict on some hosts.
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python -m backend.ops.agent.server --socket /run/bifrost-agent/bifrost-agent.sock --log-level INFO
RuntimeDirectory=bifrost-agent
Restart=on-failure
RestartSec=5

# Security hardening (ProtectHome=false: agent must read project under /home; alternative: deploy copy under /opt/bifrost + ProtectHome=true)
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=false
# Project tree + sudo timestamp dir (some hosts error on /run/sudo/ts/* if /run/sudo is not writable in the unit).
ReadWritePaths=/home/vision/bifrost-trader-engine /run/sudo
PrivateTmp=true

# Socket mode 0660 is set in backend.ops.agent.server after bind (no ExecStartPost: it races
# Type=simple startup and fails before the socket exists, masking real Python/import errors).

[Install]
WantedBy=multi-user.target
