# Example systemd unit — IB Gateway (scripts/run_ib_gateway.py): Redis Stream RPC + sole TWS client_ids.
# Copy to /etc/systemd/system/, adjust User/Group/WorkingDirectory and Python venv path, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bifrost-ib-gateway.service
#
# Add the unit stem to ops.allowed_units (e.g. bifrost-ib-gateway) for Ops API control.

[Unit]
Description=Bifrost IB Gateway (Redis Stream RPC)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=bifrost
Group=bifrost
WorkingDirectory=/opt/bifrost-trader-engine
ExecStart=/opt/bifrost-trader-engine/.venv/bin/python scripts/run_ib_gateway.py --config config/config.prod.yaml
Restart=on-failure
RestartSec=5
# Allow time for the main loop to exit the blocking XREADGROUP (see ib_gateway block_ms) and run disconnect_all().
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
