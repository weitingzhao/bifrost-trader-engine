[Unit]
Description=Bifrost Strategy Trading Daemon (run_engine.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_ENV=prod
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/systemd/run_engine.py --prod
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
