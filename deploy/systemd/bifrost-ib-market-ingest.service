# Example systemd unit — IB market ingest (scripts/run_ib_market_ingest.py).
# Copy to /etc/systemd/system/, adjust User/Group/WorkingDirectory and Python venv path, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bifrost-ib-market-ingest.service
#
# Add the unit stem to ops.allowed_units in config (e.g. bifrost-ib-market-ingest) for Ops API control.

[Unit]
Description=Bifrost IB market data ingest
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=bifrost
Group=bifrost
WorkingDirectory=/opt/bifrost-trader-engine
ExecStart=/opt/bifrost-trader-engine/.venv/bin/python scripts/run_ib_market_ingest.py --config config/config.prod.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
