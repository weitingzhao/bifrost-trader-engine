[Unit]
Description=Bifrost Celery worker instance %i (stocks_ib / options_massive / stocks_massive queues, run_celery.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_ENV=prod
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/systemd/run_celery.py --prod --instance %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
