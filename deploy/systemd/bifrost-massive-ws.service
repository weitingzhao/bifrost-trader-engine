# Massive Options WebSocket ingest (scripts/systemd/run_massive_ws.py).
# Default paths match scripts/bifrost_ssh.sh (DEPLOY_PATH) and bifrost-server.service.
# rsync excludes config/config.prod.yaml unless you pass --sync-prod-config — without it, --config may 404 on the server.
#
#   sudo cp deploy/systemd/bifrost-massive-ws.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bifrost-massive-ws.service

[Unit]
Description=Bifrost Massive Options WebSocket ingest
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_CONFIG=/home/vision/bifrost-trader-engine/config/config.prod.yaml
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/systemd/run_massive_ws.py --config config/config.prod.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
