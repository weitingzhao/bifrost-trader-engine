# IB ingestor — same deploy layout as bifrost-massive-ws.service (see that file for rsync/config notes).

[Unit]
Description=Bifrost IB market data ingestor
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_CONFIG=/home/vision/bifrost-trader-engine/config/config.prod.yaml
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/run_ib_ingestor.py --config config/config.prod.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
