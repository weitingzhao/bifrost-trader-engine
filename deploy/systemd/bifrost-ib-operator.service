# IB Operator — same deploy layout as bifrost-massive-ws.service.

[Unit]
Description=Bifrost IB Operator (Redis cmd RPC)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_CONFIG=/home/vision/bifrost-trader-engine/config/config.prod.yaml
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/systemd/run_ib_operator.py --config config/config.prod.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
