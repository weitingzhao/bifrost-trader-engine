[Unit]
Description=Bifrost Ops API (run_server_ops.py)
After=network-online.target bifrost-server.service
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
# Connect to bifrost-agent UDS (mode 0660, group bifrost-agent) when ops.executor_mode=agent
SupplementaryGroups=bifrost-agent
WorkingDirectory=/home/vision/bifrost-trader-engine
Environment=BIFROST_ENV=prod
# Ops Console SSE runs journalctl as User=vision; sudo is required unless vision is in group systemd-journal.
Environment=BIFROST_JOURNAL_USE_SUDO=1
ExecStart=/home/vision/bifrost-trader-engine/.venv/bin/python scripts/run_server_ops.py --prod
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
